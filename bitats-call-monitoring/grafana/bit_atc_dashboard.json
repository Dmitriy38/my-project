      "targets": [
        {
          "dataset": "pbxanalytics",
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  r.ext AS 'Номер',\r\n  r.name AS 'Оператор',\r\n  IFNULL(a.answered_calls, 0) AS 'Принято',\r\n  ROUND(IFNULL(a.avg_sec, 0) / 60, 2) AS 'Ср.разг,с',\r\n  IFNULL(a.total_calls, 0) AS 'Звонило',\r\n  IFNULL(ROUND((a.answered_calls / a.total_calls) * 100, 1), 0) AS '%поднятия'\r\nFROM pbxanalytics.rt_member_status r\r\nLEFT JOIN (\r\n  SELECT\r\n    answeredext,\r\n    COUNT(*) AS total_calls,\r\n    SUM(CASE WHEN disposition = 'ANSWERED' THEN 1 ELSE 0 END) AS answered_calls,\r\n    AVG(CASE WHEN disposition = 'ANSWERED' THEN billsec ELSE NULL END) AS avg_sec\r\n  FROM pbxanalytics.analytics\r\n  WHERE $__timeFilter(calldate)\r\n    AND direction = 'incoming'\r\n    AND modulename = 'users'\r\n  GROUP BY answeredext\r\n) a ON r.ext = a.answeredext\r\nWHERE r.ext IN (\r\n  '10001',\r\n  '10002',\r\n  '10003'  /* список номеров операторов своей АТС */\r\n)\r\nGROUP BY r.ext, r.name, a.answered_calls, a.avg_sec, a.total_calls\r\nHAVING IFNULL(a.total_calls, 0) > 0\r\nORDER BY IFNULL(a.answered_calls, 0) DESC, r.ext ASC",
          "refId": "A",
          "sql": {
            "columns": [
