# Скопировать в .env, заполнить своими значениями, .env в репозиторий не класть.

# Базовые настройки
APP_ENV=production
APP_DEBUG=false
# Сгенерировать: echo "base64:$(openssl rand -base64 32)"
APP_KEY=CHANGE_ME
APP_URL=http://<IP_сервера>:8080
APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru

# База данных (эти же переменные читает db в docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=snipeit
DB_USERNAME=snipeit_user
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# Redis (кэш и сессии)
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP можно настроить позже, пока лог вместо отправки писем
MAIL_DRIVER=log
